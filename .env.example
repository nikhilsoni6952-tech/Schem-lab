# Copy this file to .env and fill in ONE of the two options to switch the
# assistant from the offline engine to a real AI model. Restart the server after.

# Option 1 — Claude (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5-20251001      # optional, this is the default

# Option 2 — any OpenAI-compatible provider. All three lines are required.
# Use the model name from your provider's current model list.
# AI_API_KEY=...
# AI_BASE_URL=https://api.groq.com/openai/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1   (AI_API_KEY can be any text)
# AI_MODEL=...
# AI_LABEL=Groq                            # optional name shown in the chat header

# Sign in with Google (optional). Create an OAuth client of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   http://127.0.0.1:8000/auth/google/callback/      (and https://<your-site>/auth/google/callback/ once online)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# Let people in automatically as read-only viewers (optional): a domain list, or * for any Google account
# GOOGLE_ALLOWED_DOMAINS=myuniversity.edu

# Email (optional): turns on "Forgot password?" on the sign-in page and the alert digest.
# Without EMAIL_HOST, emails are printed in the runserver console instead. Gmail example
# (needs an App Password: Google Account → Security → 2-Step Verification → App passwords):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=yourlab@gmail.com
# EMAIL_HOST_PASSWORD=the-16-letter-app-password
# DEFAULT_FROM_EMAIL=S ChemLab <yourlab@gmail.com>
# SITE_URL=https://lab.example.org          # for links in the alert digest (Render sets this itself)
# ALERTS_CRON_KEY=a-long-random-string      # lets a scheduler call /alerts/send/?key=...

# Currency symbol for prices on the reorder list (default ₹)
# LAB_CURRENCY=$

# Django
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
